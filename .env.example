# Copy to .env at the repo root. Everything here has a working default for local dev.

# --- server ---
PORT=4000
NODE_ENV=development

# Signing key for guest session tokens. MUST be replaced in any deployed environment.
JWT_SECRET=dev-only-insecure-secret-change-me

# Where the SQLite file lives (relative to server/).
DATABASE_FILE=data/frido.db

# Public base URL encoded into unit QR codes. In production this is the customer-facing
# domain, e.g. https://assist.myfrido.com
PUBLIC_BASE_URL=http://localhost:5173

# --- OTP ---
# When true, the OTP is returned in the API response and printed to the server log so the
# prototype can be demoed without an SMS gateway. MUST be false in production.
DEV_OTP_ECHO=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Real SMS delivery (not wired up in the prototype — see docs/product-flow.md "Going live").
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=FRIDOX

# --- borrow policy ---
# Free window before a unit is considered overdue, and how long an extension adds.
FREE_MINUTES=120
EXTENSION_MINUTES=60
MAX_EXTENSIONS=2
