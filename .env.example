# Copy to .env at the repo root. Everything here has a working default for local dev.

# --- server ---
PORT=4000
NODE_ENV=development

# Signing key for guest session tokens. MUST be replaced in any deployed environment.
JWT_SECRET=dev-only-insecure-secret-change-me

# Where the SQLite file lives (relative to server/). Ignored when a Postgres connection
# string is present — see below.
DATABASE_FILE=data/frido.db

# Postgres takes over whenever one of these is set. On Netlify, NETLIFY_DATABASE_URL is
# injected automatically by Netlify DB; you do not set it by hand.
# DATABASE_URL=postgres://...

# Enables POST /api/admin/seed. Unset, that route returns 404 and cannot run.
# ADMIN_TOKEN=

# Public base URL encoded into unit QR codes. In production this is the customer-facing
# domain, e.g. https://assist.myfrido.com
PUBLIC_BASE_URL=http://localhost:5173

# --- OTP ---
# When true, the OTP is returned in the API response and printed to the server log so the
# prototype can be demoed without an SMS gateway.
DEV_OTP_ECHO=true

# This repo is a prototype meant to be demoed, so demo mode defaults to ON. It is what
# permits the OTP echo once NODE_ENV=production. Only safe while every row behind it is
# synthetic — set DEMO_MODE=false the moment real customer data is involved.
DEMO_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Real SMS delivery (not wired up in the prototype — see docs/product-flow.md "Going live").
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=FRIDOX

# --- borrow policy ---
# Free window before a unit is considered overdue, and how long an extension adds.
FREE_MINUTES=120
EXTENSION_MINUTES=60
MAX_EXTENSIONS=2
